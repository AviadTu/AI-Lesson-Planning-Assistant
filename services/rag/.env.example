# ── RAG HTTP server ──────────────────────────────────────────────────
RAG_HOST=0.0.0.0
RAG_PORT=8001
RAG_DEBUG=false

# ── Local storage ────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
REGISTRY_DB_PATH=./data/registry.db

# ── Uploads ──────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=txt,pdf,docx

# ── ChromaDB ─────────────────────────────────────────────────────────
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=lesson_plans

# ── Chunking (character-based) ───────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Embeddings (local Ollama daemon — always local) ──────────────────
OLLAMA_EMBEDDINGS_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=120

# ── LLM provider selection ───────────────────────────────────────────
# Switch providers by changing LLM_PROVIDER only:
#   llama_cpp     = local GGUF via llama-cpp-python
#   ollama_cloud  = direct Ollama Cloud API (HTTPS + key); falls back to
#                   llama_cpp automatically if the cloud is unavailable.
LLM_PROVIDER=ollama_cloud

# ── Ollama Cloud generation (direct API — NOT the local daemon) ──────
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b

# ── llama.cpp / local GGUF model (LLM_PROVIDER=llama_cpp) ────────────
LLM_MODEL_PATH=C:\AI-Models\Qwen3-14B\Qwen3-14B-Q4_K_M.gguf
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.2
LLM_THREADS=8
LLM_N_GPU_LAYERS=0

# ── Retrieval ────────────────────────────────────────────────────────
# top_k: default number of chunks returned by /retrieve.
RETRIEVAL_K=3
# Minimum cosine similarity (1 - cosine distance) required to return a chunk.
SIMILARITY_THRESHOLD=0.3
