# ── lesson-agent HTTP server ─────────────────────────────────────────
LESSON_AGENT_HOST=0.0.0.0
LESSON_AGENT_PORT=8004
LESSON_AGENT_DEBUG=false

# ── Conversation state (LangGraph checkpointer) ──────────────────────
CHECKPOINT_DB_PATH=./data/lesson_agent_checkpoints.sqlite

# ── LLM provider (see app/llm/). Default Ollama. ─────────────────────
# ollama = local daemon (fast tier) + Ollama Cloud (strong tier).
# openai = OpenAI Chat Completions (implemented; opt-in — fill OPENAI_* below).
LLM_PROVIDER=ollama

# ── OpenAI (only when LLM_PROVIDER=openai — implemented, not active) ──
# OPENAI_API_KEY=                          # required only when provider=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_FAST_MODEL=gpt-4o-mini            # fast tier (labelling)
# OPENAI_STRONG_MODEL=gpt-4o               # strong tier (generation)

# ── LOCAL model: classification + missing-info detection ─────────────
LOCAL_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.1:latest
LOCAL_TEMPERATURE=0.0

# ── CLOUD model: ideas / lesson generation / revisions ───────────────
# Reuses the same Ollama Cloud endpoint + key as the RAG service (repo-root .env).
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b
CLOUD_TEMPERATURE=0.4
CLOUD_MAX_TOKENS=1500

# ── Optional: Langfuse tracing (feature-flagged; no-op when off) ─────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
