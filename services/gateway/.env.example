# ── Gateway HTTP server ──────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_DEBUG=false

# ── SQLite (sessions + chat history) ────────────────────────────────
SQLITE_PATH=./data/gateway.db

# ── Frontend templates (empty = auto-detect) ────────────────────────
# FRONTEND_TEMPLATES_DIR=

# ── Downstream service URLs ─────────────────────────────────────────
RAG_SERVICE_URL=http://localhost:8001
IMAGE_ANALYZER_URL=http://localhost:8002
GUARDRAILS_URL=http://localhost:8003

# ── n8n workflow webhooks (leave empty until workflows exist) ───────
N8N_LESSON_CREATION_WEBHOOK_URL=
N8N_EXPORT_WEBHOOK_URL=

# ── Conversation memory window ──────────────────────────────────────
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=500

# ── Misc ────────────────────────────────────────────────────────────
HTTP_TIMEOUT=60
MAX_UPLOAD_MB=20
