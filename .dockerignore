# Build context is the repository root (see each service's Dockerfile).
# Keep images small and free of secrets / runtime state.

# ── Secrets & env ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Version control ──────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Python caches / build ────────────────────────────────────────────
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info
.eggs
build
dist
.pytest_cache
.mypy_cache
.ruff_cache

# ── Virtual environments ─────────────────────────────────────────────
.venv
venv
env
ENV

# ── Runtime data & models (mounted at runtime, never baked in) ───────
data
**/data
*.db
*.sqlite
*.sqlite3
models
*.gguf

# ── Logs / editor / OS ───────────────────────────────────────────────
*.log
logs
.vscode
.idea
.DS_Store
Thumbs.db
desktop.ini
~$*

# ── Docs & assets not needed at runtime ──────────────────────────────
README.md
screenshots
submissions
n8n

# ── Cursor / agent transcripts ───────────────────────────────────────
.cursor
terminals
