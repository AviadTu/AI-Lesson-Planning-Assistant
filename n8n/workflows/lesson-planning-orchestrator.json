      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sp=$json||{}; const base=$('Intake & Validate').first().json;\nconst sources=sp.sources||[]; const warnings=sp.warnings||[]; const failed=sp.failed_sources||[];\nreturn [{json:{session_id:base.session_id,message:base.message,sources,warnings,failed_sources:failed,\n  source_count:sources.length}}];"
      },
      "id": "3b29ff2c-143d-4074-8a36-85a9b2fe14af",
      "name": "Inspect Source Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
