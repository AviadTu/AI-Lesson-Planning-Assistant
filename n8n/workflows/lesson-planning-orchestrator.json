{
  "name": "Lesson Planning Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lesson-orchestrator",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "ff594c99-6873-42c9-b6e9-50616e301f0d",
      "name": "Webhook In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "webhookId": "4e2b7db2-91ad-4d72-af95-fc13da45e614"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $json.body || {};\nconst session_id = String(b.session_id || '').trim();\nconst message = String(b.message || '').trim();\nreturn [{ json: { session_id, message, valid: !!(session_id && message) } }];"
      },
      "id": "21848e83-bf9d-4315-be8d-9fa7d90cdeaf",
      "name": "Intake & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "9f183ebd-d632-4c54-90e3-768ab5c7b1a6",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "3a0fbfab-ebf7-4179-9631-c17e9a34606f",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": \"בקשה לא תקינה: חסר מזהה שיחה או הודעה.\" } }}",
        "options": {}
      },
      "id": "938f3864-5216-4c2c-949e-42d6b2014fc1",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        780,
        460
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const message = $json.message;\nconst urls = message.match(/https?:\\/\\/[^\\s)]+/g) || [];\nconst youtube = urls.filter(u => /youtube\\.com|youtu\\.be/i.test(u));\nconst articles = urls.filter(u => !/youtube\\.com|youtu\\.be/i.test(u));\nreturn [{ json: { session_id: $json.session_id, message,\n  detected: { article_urls: articles, youtube_urls: youtube, rag: true, url_count: urls.length } } }];"
      },
      "id": "a3be3294-fd4b-4a47-b7ad-57ccc64e4024",
      "name": "Detect Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "yulzQcUFjXD4fVg7",
          "mode": "id"
        },
        "options": {}
      },
      "id": "f47f8156-d97f-476b-933b-0352a5c60ef6",
      "name": "Source Processing",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        980,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sp = $json || {};\nconst base = $('Detect Sources').first().json;\nreturn [{ json: { session_id: base.session_id, message: base.message,\n  sources: sp.sources || [], warnings: sp.warnings || [] } }];"
      },
      "id": "4b0f72aa-86a4-493f-8ab4-831192679282",
      "name": "Build Agent Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8004/turn",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $json.session_id, \"message\": $json.message, \"sources\": $json.sources } }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "bbd3528b-27fc-487d-92f4-f8cc941815c6",
      "name": "Lesson Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $json || {};\nlet answer = r.reply || '';\nconst warnings = ($('Build Agent Request').first().json.warnings) || [];\nif (r.stage === 'final' && r.lesson) {\n  const need = ['opening','central_idea','summary'];\n  const missing = need.filter(k => !r.lesson[k]);\n  if (missing.length) answer += '\\n\\n(הערה: חלק מהמקטעים חסרים — ניתן לבקש השלמה.)';\n}\nif (warnings.length) answer += '\\n\\n' + warnings.join('\\n');\nreturn [{ json: { answer, stage: r.stage || 'intake' } }];"
      },
      "id": "fd2edb44-165b-43ad-b4f5-a5ab23e64fe4",
      "name": "Validate Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": $json.answer, \"stage\": $json.stage } }}",
        "options": {}
      },
      "id": "4e8abdbe-74eb-43c1-af22-d651b873de9f",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1780,
        200
      ]
    }
  ],
