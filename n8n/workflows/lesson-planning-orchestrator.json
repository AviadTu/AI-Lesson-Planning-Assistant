{
  "name": "Lesson Planning Orchestrator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lesson-orchestrator",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "fb8f3bc2-a8a4-4a9f-a419-61c39878062f",
      "name": "Webhook In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        300
      ],
      "webhookId": "e1d7605d-5ad4-4255-8c42-b0d16f68709e"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$json.body||{};\nconst session_id=String(b.session_id||'').trim();\nconst message=String(b.message||'').trim();\nreturn [{json:{session_id,message,want_web:!!b.want_web,attachments:Array.isArray(b.attachments)?b.attachments:[],valid:!!(session_id&&message)}}];"
      },
      "id": "62df7c8b-b818-4b28-ba69-18b7cd58c0c8",
      "name": "Intake & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "a56355c2-e99e-411d-a489-dd761120ee47",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      },
      "id": "0ef38423-d722-48f1-8ca6-1f4abd34d006",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": \"בקשה לא תקינה: חסר מזהה שיחה או הודעה.\" } }}",
        "options": {}
      },
      "id": "9a1cd945-1f2b-4e96-91e3-568339bac8e0",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        780,
        460
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const message=$json.message; const urls=message.match(/https?:\\/\\/[^\\s)]+/g)||[];\nconst youtube=urls.filter(u=>/youtube\\.com|youtu\\.be/i.test(u));\nconst articles=urls.filter(u=>!/youtube\\.com|youtu\\.be/i.test(u));\nreturn [{json:{session_id:$json.session_id,message,want_web:$json.want_web,attachments:$json.attachments,\n  detected:{article_urls:articles,youtube_urls:youtube,rag:true,attachment_count:($json.attachments||[]).length}}}];"
      },
      "id": "8598ba28-0a68-4870-a57a-3cdf560e8a39",
      "name": "Detect Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "yulzQcUFjXD4fVg7",
          "mode": "id"
        },
        "options": {}
      },
      "id": "f3494a86-6df2-45d4-a3f3-dc53c1e27462",
      "name": "Execute Lesson Source Processing",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        980,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sp=$json||{}; const base=$('Detect Sources').first().json;\nconst sources=sp.sources||[]; const warnings=sp.warnings||[]; const failed=sp.failed_sources||[];\nreturn [{json:{session_id:base.session_id,message:base.message,sources,warnings,failed_sources:failed,\n  source_count:sources.length}}];"
      },
      "id": "124b68e6-23f1-47ba-a038-e57866369678",
      "name": "Inspect Source Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{session_id:$json.session_id,message:$json.message,sources:$json.sources||[],warnings:$json.warnings||[]}}];"
      },
      "id": "d5651d08-98c2-4106-8e11-101af3831e3a",
      "name": "Build Agent Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8004/turn",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $json.session_id, \"message\": $json.message, \"sources\": $json.sources } }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "e7feb9b3-2a4f-465c-95dc-b3713a42af81",
      "name": "Lesson Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1580,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$json||{}; let answer=r.reply||'';\nconst warnings=($('Build Agent Request').first().json.warnings)||[];\nif(r.stage==='final'&&r.lesson){ const need=['opening','central_idea','summary']; const miss=need.filter(k=>!r.lesson[k]);\n  if(miss.length) answer+='\\n\\n(הערה: חלק מהמקטעים חסרים — ניתן לבקש השלמה.)'; }\nif(warnings.length) answer+='\\n\\n'+warnings.join('\\n');\nreturn [{json:{answer,stage:r.stage||'intake'}}];"
      },
      "id": "1af66052-2b7b-48ed-99f2-3bd3fb2df6f1",
      "name": "Validate Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": $json.answer, \"stage\": $json.stage } }}",
        "options": {}
      },
      "id": "edbe6d82-a1c7-40fb-89d8-6ed95cae307e",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1980,
        200
      ]
    }
  ],
  "connections": {
