    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:8004/lesson/{{ $json.body.session_id }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d8312fd8-dc74-4c0c-a9dd-485c3f403437",
      "name": "Get Lesson",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        384,
        288
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/internal/pdf",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"lesson\": $json.lesson, \"session_id\": $json.session_id } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "352c7629-908d-4001-9e27-8175c5af915d",
      "name": "Render PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        608,
        288
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const gl=$('Get Lesson').first().json||{}; const rp=$input.first().json||{};\nconst msg=(($('Webhook In').first().json.body||{}).message)||'';\nconst em=(msg.match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/)||[])[0]||'aviadq@gmail.com';\nconst wantEmail=/מייל|אימייל|email|gmail/i.test(msg);\nif(!gl.has_lesson){ return [{json:{answer:'עדיין אין מערך שיעור מוכן להורדה. נשלים אותו קודם, ואז אפשר להפיק PDF.',want_email:false,download_url:''}}]; }\nif(rp&&rp.download_url){ let ans='מערך השיעור מוכן! [להורדת ה-PDF]('+rp.download_url+')'; if(wantEmail){ ans+=' — הקובץ נשלח לכתובת '+em+' במייל.'; } return [{json:{answer:ans,want_email:wantEmail,download_url:rp.download_url,recipient:em,lesson_title:((gl.lesson&&gl.lesson.meta&&gl.lesson.meta.title)||'מערך שיעור')}}]; }\nreturn [{json:{answer:'אירעה תקלה בהפקת ה-PDF. נסה/י שוב.',want_email:false,download_url:''}}];"
      },
      "id": "5c75f07c-64b9-4465-ad67-14fb796144de",
      "name": "Build Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        288
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "57d61b9c-73f6-4381-86c7-0ea9d31e05d1",
              "leftValue": "={{ $json.want_email }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "afbf412b-f2f5-4e4f-b459-4513f894f373",
      "name": "Wants Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1056,
        288
      ]
    },
    {
