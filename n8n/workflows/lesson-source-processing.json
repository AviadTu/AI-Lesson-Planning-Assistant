      "parameters": {
        "jsCode": "const t=$json; const message=t.message||''; const items=[];\nitems.push({json:{source_type:'rag',message,session_id:t.session_id}});\nconst urls=message.match(/https?:\\/\\/[^\\s)]+/g)||[];\nfor(const url of urls){ if(/youtube\\.com|youtu\\.be/i.test(url)) items.push({json:{source_type:'youtube',url,message}});\n  else items.push({json:{source_type:'article',url,message}}); }\n// web search: only when the user explicitly asks (Perplexity credential handles auth)\nif(t.want_web||/חפש|באינטרנט|web|perplexity/i.test(message)) items.push({json:{source_type:'web',message}});\n// attachments: documents & images (base64 from Gateway)\nfor(const a of (t.attachments||[])){ if(a.kind==='document') items.push({json:{source_type:'document',filename:a.filename,mime:a.mime,content_base64:a.content_base64}});\n  else if(a.kind==='image') items.push({json:{source_type:'image',filename:a.filename,mime:a.mime,content_base64:a.content_base64}}); }\nreturn items;"
      },
