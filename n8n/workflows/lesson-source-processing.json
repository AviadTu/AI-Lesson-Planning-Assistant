      "parameters": {
        "jsCode": "const a=$('Detect Source Types').item.json; const fn=(a.filename||'').toLowerCase(); const mime=(a.mime||'').toLowerCase();\nlet ftype='unknown';\nif(mime.includes('pdf')||fn.endsWith('.pdf')) ftype='pdf';\nelse if(mime.includes('word')||fn.endsWith('.docx')) ftype='docx';\nelse if(mime.includes('text')||fn.endsWith('.txt')) ftype='txt';\nreturn [{json:{file_type:ftype,filename:a.filename,mime:a.mime,content_base64:a.content_base64},binary:$binary}];"
