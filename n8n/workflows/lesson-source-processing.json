      "parameters": {
        "jsCode": "const html=String($json.data||''); const m=html.match(/\"captionTracks\":(\\[.*?\\])/);\nlet cap=''; if(m){try{const t=JSON.parse(m[1].replace(/\\\\u0026/g,'&')); if(t.length&&t[0].baseUrl) cap=t[0].baseUrl;}catch(e){}}\nconst tm=html.match(/<title>([^<]*)<\\/title>/); const title=tm?tm[1].replace(' - YouTube',''):'YouTube';\nconst src=$('Extract Video ID').item.json;\nreturn [{json:{cap_url:cap,url:src.url,title}}];"
      },
