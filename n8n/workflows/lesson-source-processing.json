    {
      "parameters": {
        "jsCode": "const a=$('Detect Source Types').item.json; const fn=a.filename||'image';\nconst j=$json; let text='';\nconst c=j.content;\nif(typeof c==='string') text=c;\nelse if(c && Array.isArray(c.parts)) text=c.parts.map(p=>(p&&p.text)||'').join(' ');\nelse if(typeof j.text==='string') text=j.text;\nelse if(j.candidates && j.candidates[0]) { const p=(((j.candidates[0].content)||{}).parts)||[]; text=p.map(x=>(x&&x.text)||'').join(' '); }\ntext=(text||'').toString().trim().slice(0,4000);\nif(!text) return [{json:{source_type:'_failed',type:'_failed',failed:{type:'image',filename:fn,reason:'image analysis failed'},dkey:'fail-'+fn}}];\nreturn [{json:{type:'image',title:fn,text,url:null,citation:fn,metadata:{filename:fn,mime:a.mime},dkey:'img|'+fn+'|'+text.slice(0,80)}}];"
      },
