        "jsCode": "const url=$('Detect Source Types').item.json.url;\nconst text=String($json.text||'').replace(/\\s+/g,' ').trim().slice(0,4000);\nif(!text) return [{json:{source_type:'_failed',type:'_failed',failed:{type:'url',url,reason:'could not extract article text'},dkey:'fail-'+url}}];\nreturn [{json:{type:'url',title:url,text,url,citation:url,metadata:{},dkey:'url|'+url+'|'+text.slice(0,80)}}];"
