    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const chunks = ($json.chunks) || [];\n// Always emit >=1 item so the aggregate always runs (empty KB => marker,\n// filtered out in Return Unified Context).\nif (!chunks.length) return [{ json: { type:'_marker', title:'', text:'', url:null, citation:'', dkey:'_marker' } }];\nreturn chunks.map(c => ({ json: { type:'rag', title: c.original_filename || 'knowledge base',\n  text: c.text || '', url: null, citation: c.original_filename || 'RAG',\n  dkey: 'rag||' + String(c.text||'').slice(0,80) } }));"
      },
      "id": "5b3c4fc4-e836-448c-8b31-8ae5317e7ff6",
      "name": "Normalize RAG",
      "type": "n8n-nodes-base.code",
