        "jsCode": "function strip(h){return String(h).replace(/<script[\\s\\S]*?<\\/script>/gi,' ').replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&#39;/g,\"'\").replace(/\\s+/g,' ').trim();}\n const c=$('Extract Caption URL').item.json; const text=strip($json.data||'').slice(0,4000);\nif(!text) return [{json:{source_type:'_failed',type:'_failed',failed:{type:'youtube',url:c.url,reason:'no captions available'},dkey:'fail-'+c.url}}];\nreturn [{json:{type:'youtube',title:c.title||'YouTube',text,url:c.url,citation:c.url,metadata:{},dkey:'yt|'+c.url+'|'+text.slice(0,80)}}];"
      },
