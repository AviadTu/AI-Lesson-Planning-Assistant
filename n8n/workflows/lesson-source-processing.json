      "parameters": {
        "jsCode": "const items=$input.all().map(i=>i.json);\nconst sources=items.filter(s=>s&&s.type&&!['_marker','_failed'].includes(s.type)&&s.text)\n  .map(s=>({type:s.type,title:s.title,text:s.text,url:(s.url??null),citation:s.citation,metadata:s.metadata||{}}));\nconst failed=items.filter(s=>s&&s.type==='_failed').map(s=>s.failed);\nconst warnings=failed.map(f=>`מקור מסוג ${f.type} נכשל: ${f.reason||''}`.trim());\nreturn [{json:{sources,warnings,failed_sources:failed,count:sources.length}}];"
