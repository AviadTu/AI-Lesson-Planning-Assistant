        "jsCode": "const c=($json.chunks)||[];\nif(!c.length) return [{json:{source_type:'_marker',type:'_marker',text:'',dkey:'_marker'}}];\nreturn c.map(x=>({json:{type:'rag',title:x.original_filename||'knowledge base',text:x.text||'',url:null,citation:x.original_filename||'RAG',metadata:{doc_id:x.doc_id,page:x.page_number},dkey:'rag||'+String(x.text||'').slice(0,80)}}));"
