        "mode": "runOnceForAllItems",
        "jsCode": "const m = String($json.data||'').match(/\"captionTracks\":(\\[.*?\\])/);\nlet cap=''; if(m){ try{ const t=JSON.parse(m[1].replace(/\\\\u0026/g,'&')); if(t.length&&t[0].baseUrl) cap=t[0].baseUrl; }catch(e){} }\nconst src = $('Detect Source Types').item.json;\nreturn [{ json: { cap_url: cap, url: src.url } }];"
      },
