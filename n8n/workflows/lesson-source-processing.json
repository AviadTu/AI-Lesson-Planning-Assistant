    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\n// Partial-failure handling: drop the empty-KB marker and any empty/failed source.\nconst sources = items.map(i => i.json)\n  .filter(s => s && s.type && s.type !== '_marker' && s.text)\n  .map(s => ({ type:s.type, title:s.title, text:s.text, url:(s.url ?? null), citation:s.citation }));\nreturn [{ json: { sources, warnings: [], count: sources.length } }];"
      },
