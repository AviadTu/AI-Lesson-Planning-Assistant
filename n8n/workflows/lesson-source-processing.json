      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = $json; const message = t.message || ''; const items = [];\nitems.push({ json: { source_type:'rag', message, session_id: t.session_id } });\nconst urls = message.match(/https?:\\/\\/[^\\s)]+/g) || [];\nfor (const url of urls) {\n  const isYt = /youtube\\.com|youtu\\.be/i.test(url);\n  if (isYt) { const vid = (url.match(/(?:v=|youtu\\.be\\/)([\\w-]{11})/)||[])[1] || '';\n    items.push({ json: { source_type:'youtube', url, vid, page_url:'https://www.youtube.com/watch?v='+vid, message } }); }\n  else items.push({ json: { source_type:'article', url, message } });\n}\nlet ppx=''; try { ppx = $env.PERPLEXITY_API_KEY || ''; } catch(e){}\nif (ppx) items.push({ json: { source_type:'web', message } });\nreturn items;"
      },
