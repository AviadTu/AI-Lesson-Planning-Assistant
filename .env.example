# ─────────────────────────────────────────────────────────────────────
# RAG service environment (read by the RAG service from the repo root)
# Copy to .env and fill in secrets. NEVER commit a real .env.
#
# Generation → direct Ollama Cloud API (HTTPS + API key).
# Embeddings → local Ollama daemon (nomic-embed-text).
# These are deliberately two separate endpoints.
# ─────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────
LLM_PROVIDER=ollama_cloud                 # ollama_cloud | llama_cpp
MAX_UPLOAD_MB=20                          # optional (default 20)
ALLOWED_UPLOAD_EXTENSIONS=txt,pdf,docx    # optional

# ── LLM (shared by both providers) ───────────────────────────────────
LLM_TEMPERATURE=0.2                        # optional
LLM_MAX_TOKENS=700                         # optional

# ── Ollama Cloud (direct API — NOT the local daemon) ─────────────────
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=                            # required for ollama_cloud (secret)
OLLAMA_CLOUD_MODEL=gemma4:31b

# ── Local LLM (llama.cpp — optional fallback for the demo) ───────────
LLM_MODEL_PATH=                            # required when LLM_PROVIDER=llama_cpp
LLM_CONTEXT_SIZE=4096                      # optional
LLM_THREADS=8                              # optional
LLM_N_GPU_LAYERS=0                         # optional (0 = CPU only)

# ── Embeddings (local Ollama daemon — always local) ──────────────────
OLLAMA_EMBEDDINGS_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
